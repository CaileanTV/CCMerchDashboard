{
  "name": "ccmerch/ccmerch-dashboard",
  "description": "Creator and merchandise management plugin for WordPress.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "brain/monkey": "^2.7",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.2",
    "phpunit/phpunit": "^11.5",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-coding-standards/wpcs": "^3.4"
  },
  "autoload": {
    "psr-4": {
      "CCMerch\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "CCMerch\\Tests\\Unit\\": "tests/Unit/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "check": [
      "@lint",
      "@analyse",
      "@test"
    ],
    "test": "phpunit"
  },
  "scripts-descriptions": {
    "lint": "Check PHP against WordPress Coding Standards.",
    "lint:fix": "Auto-fix fixable coding standard violations.",
    "analyse": "Run PHPStan static analysis with WordPress stubs.",
    "check": "Run all PHP quality checks.",
    "test": "Run PHPUnit tests."
  }
}
