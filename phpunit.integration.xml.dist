<?xml version="1.0" encoding="UTF-8"?>
<!-- Integration tests against a real MySQL/MariaDB. Run with `npm run test:integration` (docs/TESTING.md). -->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/Integration/bootstrap.php"
	cacheDirectory=".phpunit.cache/integration"
	colors="true"
	executionOrder="random"
	failOnWarning="true"
	failOnRisky="true"
	failOnDeprecation="true"
	failOnNotice="true"
	beStrictAboutOutputDuringTests="true">
	<!-- The whole suite passed 112 MB with 995 tests; PHP CLI's default 128M ends it silently (WordPress' fatal error handler). -->
	<php>
		<ini name="memory_limit" value="512M"/>
	</php>
	<testsuites>
		<testsuite name="integration">
			<directory>tests/Integration</directory>
		</testsuite>
	</testsuites>
	<!-- The sales benchmark (tests/Integration/Benchmark, ADR-040 pkt. 15) is opt-in; docs/TESTING.md has the command. -->
	<groups>
		<exclude>
			<group>benchmark</group>
		</exclude>
	</groups>
	<source>
		<include>
			<directory>src</directory>
		</include>
	</source>
</phpunit>
