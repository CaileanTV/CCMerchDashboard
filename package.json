{
  "name": "merchboard",
  "version": "1.0.1",
  "private": true,
  "description": "Creator and merchandise management plugin for WordPress.",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "composer": "node bin/composer.mjs",
    "build": "wp-scripts build dashboard=./assets/src/dashboard/index.tsx overlay=./assets/src/overlay/index.ts alerts-admin=./assets/src/admin/alerts-admin.ts alerts-global-admin=./assets/src/admin/alerts-global-admin.tsx alerts-presets-admin=./assets/src/admin/alerts-presets-admin.tsx alerts-page-admin=./assets/src/admin/alerts-page-admin.tsx --output-path=build",
    "i18n": "npm run build && node bin/composer.mjs i18n",
    "package": "npm run build && node bin/package.mjs",
    "start": "wp-scripts start dashboard=./assets/src/dashboard/index.tsx overlay=./assets/src/overlay/index.ts alerts-admin=./assets/src/admin/alerts-admin.ts alerts-global-admin=./assets/src/admin/alerts-global-admin.tsx alerts-presets-admin=./assets/src/admin/alerts-presets-admin.tsx alerts-page-admin=./assets/src/admin/alerts-page-admin.tsx --output-path=build",
    "typecheck": "tsc -p tsconfig.json",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "wp-scripts lint-style",
    "lint:php": "node bin/composer.mjs lint",
    "analyse:php": "node bin/composer.mjs analyse",
    "test:js": "wp-scripts test-unit-js",
    "test:php": "node bin/composer.mjs test",
    "format": "wp-scripts format",
    "lint": "npm run lint:js && npm run lint:css && npm run typecheck && npm run lint:php && npm run analyse:php",
    "wp:start": "wp-playground-cli server --php=8.2 --port=9400 --login --mount-dir . /wordpress/wp-content/plugins/merchboard --blueprint=./blueprint.json",
    "test": "npm run test:php && npm run test:js",
    "test:integration": "node bin/integration.mjs"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wordpress/api-fetch": "7.56.0",
    "@wordpress/element": "8.8.0",
    "@wordpress/i18n": "6.29.0",
    "@wordpress/scripts": "35.0.0",
    "@wp-playground/cli": "3.1.55",
    "typescript": "6.0.3"
  }
}
