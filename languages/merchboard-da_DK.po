#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:76
msgid "Not saved: a field is too long or contains line breaks or other control characters."
msgstr "Ikke gemt: et felt er for langt eller indeholder linjeskift eller andre kontroltegn."

