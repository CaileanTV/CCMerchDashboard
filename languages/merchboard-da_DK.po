msgstr "Juridisk navn (person eller virksomhed)"

#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:270
msgid "Address, line 2"
msgstr "Adresse, linje 2"

#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:271
