#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:62
msgid "Nothing was changed: this code is already the creator's active code."
msgstr "Intet blev ændret: koden er allerede creatorens aktive kode."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:63
msgid "Not saved: enter a coupon code of at most 191 characters."
msgstr "Ikke gemt: indtast en kuponkode på højst 191 tegn."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:64
msgid "Not saved: there is no WooCommerce coupon with this code."
msgstr "Ikke gemt: der findes ingen WooCommerce-kupon med denne kode."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:65
msgid "Not saved: this is a gift card code, not a discount code."
msgstr "Ikke gemt: det er en gavekortkode, ikke en rabatkode."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:66
msgid "Not saved: it could not be checked whether this is a gift card code. Try again later."
msgstr "Ikke gemt: det kunne ikke kontrolleres, om det er en gavekortkode. Prøv igen senere."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:67
msgid "Not saved: this code is the active code of another creator."
msgstr "Ikke gemt: koden er en anden creators aktive kode."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:68
msgid "The creator has no active discount code."
msgstr "Creatoren har ingen aktiv rabatkode."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:69
msgid "Another change of this code is in progress. Nothing was changed; try again."
msgstr "En anden ændring af koden er i gang. Intet blev ændret; prøv igen."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:70
msgid "You are not allowed to manage creator discount codes."
msgstr "Du har ikke tilladelse til at administrere creator-rabatkoder."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:84
msgid "The WooCommerce coupon with this code no longer exists."
msgstr "WooCommerce-kuponen med denne kode findes ikke længere."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:85
msgid "The code now belongs to another WooCommerce coupon than the registered one."
msgstr "Koden tilhører nu en anden WooCommerce-kupon end den registrerede."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:98
#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:614
msgid "Discount code"
msgstr "Rabatkode"

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:99
msgid "The creator's own WooCommerce coupon, which lets the creator buy their own merchandise without paying for their profit. Orders that use it do not count in the creator's sales, profit or payouts, whichever creators' products they contain. Every order with the code counts nowhere, whoever placed it. A code applies to orders created from its registration on; earlier orders are never changed."
msgstr "Creatorens egen WooCommerce-kupon, som lader creatoren købe sit eget merchandise uden at betale for sin fortjeneste. Ordrer, der bruger den, tæller ikke med i creatorens salg, fortjeneste eller udbetalinger, uanset hvilke creators produkter de indeholder. Alle ordrer med koden tæller ingen steder, uanset hvem der har købt. En kode gælder for ordrer, der oprettes fra registreringen og frem; tidligere ordrer ændres aldrig."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:114
msgid "The discount codes could not be read. Please try again later."
msgstr "Rabatkoderne kunne ikke læses. Prøv igen senere."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:139
msgid "No active discount code."
msgstr "Ingen aktiv rabatkode."

#. translators: 1: discount code, 2: date.
