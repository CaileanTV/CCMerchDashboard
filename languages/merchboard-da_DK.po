msgid "The export does not match its manifest and checksums. It is not delivered; nothing was changed."
msgstr "Eksporten stemmer ikke med sit manifest og sine checksums. Den udleveres ikke; intet er ændret."

#: src/Modules/WooCommerce/Admin/PayoutRecalculationExportDownload.php:124
msgid "The export or file does not exist."
msgstr "Eksporten eller filen findes ikke."

#: src/Modules/WooCommerce/Admin/PayoutRecalculationExportDownload.php:135
