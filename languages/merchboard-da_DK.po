#: src/Core/Lifecycle/Installer.php:99
msgid "Merch Dashboard could not update its database tables. The update is retried automatically. Technical details are in the log (WooCommerce → Status → Logs, source \"merchboard\", or the server error log)."
msgstr "Merch Dashboard kunne ikke opdatere sine databasetabeller. Opdateringen forsøges igen automatisk. Tekniske detaljer står i loggen (WooCommerce → Status → Logs, kilde \"merchboard\", eller serverens fejllog)."

#: src/Core/Lifecycle/UninstallHalt.php:69
msgid "Merch Dashboard was not deleted"
msgstr "Merch Dashboard blev ikke slettet"

#: src/Core/Lifecycle/UninstallHalt.php:84
msgid "Merch Dashboard was not deleted: it could not check whether payouts are pending."
msgstr "Merch Dashboard blev ikke slettet: det kunne ikke kontrolleres, om der er ventende udbetalinger."

#. translators: %d: number of pending payouts.
#: src/Core/Lifecycle/UninstallHalt.php:86
#, php-format
msgid "Merch Dashboard was not deleted: %d payout is still pending."
msgid_plural "Merch Dashboard was not deleted: %d payouts are still pending."
msgstr[0] "Merch Dashboard blev ikke slettet: %d udbetaling afventer stadig."
msgstr[1] "Merch Dashboard blev ikke slettet: %d udbetalinger afventer stadig."

#: src/Core/Lifecycle/UninstallHalt.php:88
msgid "Nothing was deleted: its data is still in the database, and permanent deletion is still switched on. Activate Merch Dashboard again, handle the pending payouts under Merch Dashboard → Payouts, then delete the plugin again."
msgstr "Intet blev slettet: dataene ligger stadig i databasen, og permanent sletning er stadig slået til. Aktivér Merch Dashboard igen, behandl de ventende udbetalinger under Merch Dashboard → Udbetalinger, og slet derefter pluginet igen."

#: src/Core/Lifecycle/UninstallNotice.php:51
msgid "Merch Dashboard could not check whether payouts are pending."
msgstr "Merch Dashboard kunne ikke kontrollere, om der er ventende udbetalinger."

#. translators: %d: number of pending payouts.
#: src/Core/Lifecycle/UninstallNotice.php:53
#, php-format
msgid "%d Merch Dashboard payout is pending."
msgid_plural "%d Merch Dashboard payouts are pending."
msgstr[0] "%d Merch Dashboard-udbetaling afventer."
msgstr[1] "%d Merch Dashboard-udbetalinger afventer."

#: src/Core/Lifecycle/UninstallNotice.php:55
msgid "Permanent deletion is switched on, but deleting Merch Dashboard now deletes nothing and is refused: handle the pending payouts under Merch Dashboard → Payouts first."
msgstr "Permanent sletning er slået til, men hvis Merch Dashboard slettes nu, slettes intet, og sletningen afvises: behandl først de ventende udbetalinger under Merch Dashboard → Udbetalinger."

