#, php-format
msgid "Not registered: %s."
msgstr "Ikke registreret: %s."

#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:255
msgid "Legal name (person or business)"
msgstr "Juridisk navn (person eller virksomhed)"

#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:257
