msgstr "Overførslen er gennemført uden for Merch Dashboard"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:965
msgid "Reason (shown to the creator)"
msgstr "Begrundelse (vises for creatoren)"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:967
msgid "Never enter an account number, IBAN or e-mail address: the reason is shown to the creator and kept with the payout history."
msgstr "Skriv aldrig et kontonummer, en IBAN eller en e-mailadresse: begrundelsen vises for creatoren og gemmes i udbetalingshistorikken."

