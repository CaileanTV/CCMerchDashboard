#, php-format
msgid "Active code: %1$s, since %2$s."
msgstr "Aktiv kode: %1$s, siden %2$s."

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:149
msgid "Open the coupon in WooCommerce"
msgstr "Åbn kuponen i WooCommerce"

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:155
msgid "Check the coupon:"
msgstr "Kontrollér kuponen:"

#: src/Modules/WooCommerce/Admin/CreatorCodeSection.php:155
