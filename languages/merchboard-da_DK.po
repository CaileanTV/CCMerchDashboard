#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:633
#: src/Modules/WooCommerce/Admin/PayoutsPage.php:450
#, php-format
msgid "Payout #%d"
msgstr "Udbetaling #%d"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:639
msgid "How such orders count towards the creator's commission is not decided yet (G1); the ledger, the balances and the settlement documents treat this order like any other order."
msgstr "Hvordan sådanne ordrer tæller med i creatorens kommission, er endnu ikke besluttet (G1); ledgeren, saldoen og afregningsbilagene behandler ordren som alle andre ordrer."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:674
msgid "With profit data (complete or incomplete)"
msgstr "Med profitdata (komplet eller ufuldstændig)"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:675
#: src/Modules/WooCommerce/Admin/PayoutRecalculationsPage.php:295
msgid "Complete"
msgstr "Komplet"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:676
#: build/dashboard.js:2
msgid "Incomplete"
msgstr "Ufuldstændig"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:688
msgid "No profit snapshot: snapshots are taken when an order line is created and only if its product then has a creator. Order lines created before Merch Dashboard recorded snapshots, or before their product was linked to the creator, never have one."
msgstr "Intet profit-snapshot: snapshots tages, når en ordrelinje oprettes, og kun hvis produktet da har en creator. Ordrelinjer oprettet, før Merch Dashboard gemte snapshots, eller før produktet blev koblet til creatoren, får aldrig et."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:689
msgid "The stored profit snapshot of this order line cannot be read."
msgstr "Ordrelinjens gemte profit-snapshot kan ikke læses."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:690
msgid "The snapshot is from the withdrawn pricing model and has no share of the sale price."
msgstr "Snapshottet er fra den tilbagetrukne prismodel og har ingen andel af salgsprisen."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:691
msgid "The snapshot belongs to another creator, product, variation, order or currency than this ledger row."
msgstr "Snapshottet hører til en anden creator, et andet produkt, en anden variation, ordre eller valuta end denne ledger-række."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:692
msgid "No stored tax: ledger rows registered before Merch Dashboard stored the actual tax have none, so the amount paid incl. VAT is unknown."
msgstr "Ingen gemt moms: ledger-rækker registreret, før Merch Dashboard gemte den faktiske moms, har ingen, så det betalte beløb inkl. moms er ukendt."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:693
msgid "The stored tax is in another currency than the ledger row."
msgstr "Den gemte moms er i en anden valuta end ledger-rækken."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:694
msgid "The profit cannot be calculated from the stored data."
msgstr "Profitten kan ikke beregnes ud fra de gemte data."

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:706
msgid "Unreadable"
msgstr "Ulæselig"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:714
msgid "Withdrawn model (no share)"
msgstr "Tilbagetrukket model (ingen andel)"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:718
msgid "VAT status unknown"
msgstr "Momsstatus ukendt"

#: src/Modules/WooCommerce/Admin/OrderHistoryPage.php:719
