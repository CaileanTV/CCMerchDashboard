#, php-format
msgid "Via: %s"
msgstr "Via: %s"

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:261
msgid "No mapped category justifies this link any more; the reconciliation will remove it."
msgstr "Ingen mappet kategori begrunder længere denne tilknytning; afstemningen vil fjerne den."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:262
msgid "The product is in categories of several creators; the reconciliation will remove this link."
msgstr "Produktet ligger i kategorier fra flere creators; afstemningen vil fjerne denne tilknytning."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:263
msgid "The product's categories are now mapped to another creator; the reconciliation will move this link."
msgstr "Produktets kategorier er nu mappet til en anden creator; afstemningen vil flytte denne tilknytning."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:264
msgid "The category state could not be evaluated."
msgstr "Kategoritilstanden kunne ikke vurderes."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:284
msgid "Keep the product with this creator as a manual link. Product categories will no longer change it; only an administrator can remove it."
msgstr "Behold produktet hos denne creator som en manuel tilknytning. Produktkategorier ændrer den ikke længere; kun en administrator kan fjerne den."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:285
msgid "Keep as manual"
msgstr "Behold som manuel"

