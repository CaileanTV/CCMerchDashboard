msgstr "Navnet på appens bot hos Kick, som vises for creators (valgfrit)."

#: src/Modules/Alerts/Admin/ChatbotAdminTab.php:245
msgid "Bot messages at Kick"
msgstr "Bot-beskeder hos Kick"

#: src/Modules/Alerts/Admin/ChatbotAdminTab.php:247
msgid "The Kick app is saved and Kick accepted its credentials."
msgstr "Kick-appen er gemt, og Kick har godkendt dens credentials."

#: src/Modules/Alerts/Admin/ChatbotAdminTab.php:248
msgid "Messages are sent as the app's bot (type \"bot\") with the channel's own token, which is stored encrypted and renewed automatically."
msgstr "Beskeder sendes som appens bot (type \"bot\") med kanalens eget token, som gemmes krypteret og fornyes automatisk."

#: src/Modules/Alerts/Admin/ChatbotAdminTab.php:249
msgid "Each creator adds the bot to the own channel (chat:write) in the dashboard."
msgstr "Hver creator tilføjer botten til sin egen kanal (chat:write) i dashboardet."

