msgstr "ID"

#: src/Modules/WooCommerce/Admin/CreatorCategoriesSection.php:202
msgid "Mapped"
msgstr "Mappet"

#: src/Modules/WooCommerce/Admin/CreatorCategoriesSection.php:203
