msgstr "CVR/SE-nummer"

#. translators: %s: list of missing fields.
#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:264
#, php-format
msgid "Not registered: %s."
msgstr "Ikke registreret: %s."

#: src/Modules/WooCommerce/Admin/PayoutSettingsSections.php:268
