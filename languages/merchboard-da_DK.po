#, php-format
msgid "%1$s, card #%2$s"
msgstr "%1$s, kort #%2$s"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:515
msgid "Register gift card"
msgstr "Registrér gavekort"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:519
msgid "No available gift card plugin is chosen in Settings → Payouts, so no gift card can be registered. The request can be rejected."
msgstr "Der er ikke valgt et tilgængeligt gavekortplugin under Settings → Payouts, så der kan ikke registreres et gavekort. Anmodningen kan afvises."

#. translators: 1: gift card plugin, 2: amount with currency, 3: payout reference.
#: src/Modules/WooCommerce/Admin/PayoutsPage.php:525
#, php-format
msgid "Create a gift card in %1$s with exactly this amount and balance: %2$s (no VAT added or deducted). Note the reference %3$s in its internal notes."
msgstr "Opret et gavekort i %1$s med præcis dette beløb og denne saldo: %2$s (uden tillæg eller fradrag af moms). Skriv referencen %3$s i kortets interne note."

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:526
msgid "Do not send or use the card. Enter its code below: Merch Dashboard checks that it is one unused, active card of this amount and currency, then completes the payout and shows the card to the creator."
msgstr "Send eller brug ikke kortet. Angiv dets kode nedenfor: Merch Dashboard kontrollerer, at det er ét ubrugt, aktivt kort med dette beløb og denne valuta, gennemfører derefter udbetalingen og viser kortet for creatoren."

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:531
msgid "Create gift card in the plugin"
msgstr "Opret gavekort i pluginet"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:538
msgid "Gift card code"
msgstr "Gavekortkode"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:540
msgid "Validate and register gift card"
msgstr "Validér og registrér gavekort"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:557
msgid "Gift card in the plugin now"
msgstr "Gavekortet i pluginet nu"

#: src/Modules/WooCommerce/Admin/PayoutsPage.php:562
msgid "The gift card cannot be read now: the plugin is not available, or the card was deleted."
msgstr "Gavekortet kan ikke læses nu: pluginet er ikke tilgængeligt, eller kortet er slettet."

#. translators: 1: status, 2: balance with currency.
