#: build/dashboard.js:7
#, js-format
msgid "You have %d keys, the most. Revoke one to make a new one."
msgstr "Du har %d nøgler, det højeste antal. Tilbagekald en for at oprette en ny."

#: build/dashboard.js:7
#: build/dashboard.js:48
#: build/dashboard.js:52
msgid "Test"
msgstr "Test"

#: build/dashboard.js:7
msgid "Make a key first: the test goes to your keys."
msgstr "Opret en nøgle først: testen sendes til dine nøgler."

#: build/dashboard.js:7
msgid "A test event is waiting for your bots. It comes with their next request within 5 minutes."
msgstr "En testhændelse venter på dine bots. Den kommer med deres næste forespørgsel inden for 5 minutter."

#: build/dashboard.js:7
msgid "Send test event"
msgstr "Send testhændelse"

#: build/dashboard.js:7
msgid "Sends a test purchase to every key, marked \"test\". Resending an alert under History also reaches your bots, marked \"resend\"."
msgstr "Sender et testkøb til hver nøgle, markeret \"test\". Gensender du en alert under Historik, når den også dine bots, markeret \"resend\"."

#: build/dashboard.js:7
msgid "How to use the API"
msgstr "Sådan bruger du API'en"

#: build/dashboard.js:7
msgid "Your bot asks this address every 5–10 seconds:"
msgstr "Din bot spørger denne adresse hvert 5.–10. sekund:"

#: build/dashboard.js:7
msgid "It sends the key in the header Authorization: Bearer, never in the address. For example:"
msgstr "Den sender nøglen i headeren Authorization: Bearer, aldrig i adressen. For eksempel:"

#: build/dashboard.js:7
msgid "The first request without \"after\" gives the cursor to start from, and no purchases. Then the bot sends after={cursor} and saves the new cursor from every answer, so it only gets new purchases and never the same one twice."
msgstr "Den første forespørgsel uden \"after\" giver cursoren at starte fra og ingen køb. Derefter sender botten after={cursor} og gemmer den nye cursor fra hvert svar, så den kun får nye køb og aldrig det samme to gange."

#. translators: %d: requests per minute.
#: build/dashboard.js:8
#, js-format
msgid "At most %d requests per key per minute; too many give the answer 429. A wrong or revoked key gives 401, and 503 means the shop has switched the API or alerts off."
msgstr "Højst %d forespørgsler pr. nøgle pr. minut; for mange giver svaret 429. En forkert eller tilbagekaldt nøgle giver 401, og 503 betyder, at shoppen har slået API'en eller alerts fra."

#: build/dashboard.js:8
msgid "Example answer"
msgstr "Eksempel på et svar"

#: build/dashboard.js:8
msgid "The fields"
msgstr "Felterne"

#: build/dashboard.js:8
msgid "The purchase line; 0 for tests and resends, which never move the cursor."
msgstr "Købslinjen; 0 for tests og gensendelser, som aldrig flytter cursoren."

#: build/dashboard.js:8
msgid "\"purchase\", \"test\" or \"resend\"."
msgstr "\"purchase\" (køb), \"test\" eller \"resend\" (gensendt)."

#: build/dashboard.js:8
msgid "The same for every line of one order, so your bot can write one message per order. It is not the order number."
msgstr "Den samme for alle linjer i en ordre, så din bot kan skrive én besked pr. ordre. Det er ikke ordrenummeret."

#: build/dashboard.js:8
msgid "The username the customer chose to show; empty when they gave none."
msgstr "Det brugernavn, kunden valgte at vise; tomt, når kunden ikke gav noget."

#: build/dashboard.js:8
msgid "What was bought."
msgstr "Hvad der blev købt."

#: build/dashboard.js:8
msgid "The address of the product's image in the shop's product size; empty when it has none."
msgstr "Adressen på produktets billede i butikkens produktstørrelse; tom, når produktet ikke har et."

#: build/dashboard.js:8
msgid "The price per item, the line and your total in the order, paid with VAT after discounts, as numbers with a point; null when unknown."
msgstr "Prisen pr. stk., linjen og din samlede del af ordren, betalt inkl. moms efter rabat, som tal med punktum; null, når beløbet er ukendt."

#: build/dashboard.js:8
msgid "waiting (you were not live; checked again after 5 minutes)"
msgstr "venter (du var ikke live; tjekkes igen efter 5 minutter)"

#: build/dashboard.js:8
msgid "waiting to be sent"
msgstr "venter på at blive sendt"

#: build/dashboard.js:8
msgid "skipped (you were not live)"
msgstr "sprunget over (du var ikke live)"

#: build/dashboard.js:8
msgid "skipped (terms not accepted)"
msgstr "sprunget over (vilkår ikke godkendt)"

#: build/dashboard.js:8
msgid "skipped (empty message)"
msgstr "sprunget over (tom besked)"

#: build/dashboard.js:8
msgid "not sent"
msgstr "ikke sendt"

#: build/dashboard.js:8
msgid "I accept the <privacy>privacy policy</privacy> and the <terms>terms of service</terms> of the YouTube chatbot."
msgstr "Jeg accepterer YouTube-chatbottens <privacy>privatlivspolitik</privacy> og <terms>vilkår</terms>."

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:9
#, js-format
msgid "Your %1$s channel"
msgstr "Din %1$s-kanal"

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:10
#, js-format
msgid "Add the bot to your channel, and it writes in your %1$s chat when someone buys your merch. You go to %1$s and allow the bot to chat in your channel; log in with your channel's account."
msgstr "Tilføj botten til din kanal, så skriver den i din %1$s-chat, når nogen køber dit merch. Du sendes til %1$s og giver botten lov til at chatte i din kanal; log ind med din kanals konto."

#: build/dashboard.js:10
msgid "Add the bot to your channel"
msgstr "Tilføj botten til din kanal"

#: build/dashboard.js:10
msgid "The privacy policy and terms of the YouTube chatbot have changed. The bot does not write in your chat until you accept them."
msgstr "Privatlivspolitikken og vilkårene for YouTube-chatbotten er ændret. Botten skriver ikke i din chat, før du godkender dem."

#: build/dashboard.js:10
msgid "Accept"
msgstr "Godkend"

#. translators: 1: channel login.
#: build/dashboard.js:11
#, js-format
msgid "The bot writes in the chat of %1$s."
msgstr "Botten skriver i chatten hos %1$s."

#. translators: 1: bot login, 2: channel login.
#: build/dashboard.js:12
#, js-format
msgid "The bot %1$s writes in the chat of %2$s."
msgstr "Botten %1$s skriver i chatten hos %2$s."

#: build/dashboard.js:12
msgid "On YouTube the bot writes only during your livestreams. If you are not live when someone buys, it checks once more after 5 minutes; otherwise the purchase is not announced in the chat. Tip: make the bot a moderator of your channel, so YouTube does not hold its messages back."
msgstr "På YouTube skriver botten kun under dine livestreams. Er du ikke live, når nogen køber, tjekker den én gang til efter 5 minutter; ellers bliver købet ikke annonceret i chatten. Tip: gør botten til moderator på din kanal, så YouTube ikke holder dens beskeder tilbage."

#. translators: 1: bot login.
#: build/dashboard.js:13
#, js-format
msgid "Tip: give the bot moderator or VIP in your channel (/mod %1$s or /vip %1$s), so it may send more messages when many buy at once."
msgstr "Tip: giv botten moderator eller VIP i din kanal (/mod %1$s eller /vip %1$s), så den må sende flere beskeder, når mange køber på én gang."

#. translators: 1: status, 2: the platform's reason or nothing.
#: build/dashboard.js:14
#, js-format
msgid "Latest message: %1$s%2$s"
msgstr "Seneste besked: %1$s%2$s"

#: build/dashboard.js:14
msgid "Send test message"
msgstr "Send testbesked"

#: build/dashboard.js:14
msgid "Remove the bot"
msgstr "Fjern botten"

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:15
#, js-format
msgid "The bot was added to your %1$s channel. It writes in your chat when someone buys your merch."
msgstr "Botten er tilføjet til din %1$s-kanal. Den skriver i din chat, når nogen køber dit merch."

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:16
#, js-format
msgid "You cancelled at %1$s. Nothing was changed."
msgstr "Du annullerede hos %1$s. Intet er ændret."

#: build/dashboard.js:16
msgid "You logged in with the bot's own account. Log in with your channel's account instead."
msgstr "Du loggede ind med bottens egen konto. Log ind med din kanals konto i stedet."

#. translators: 1: technical error code.
#: build/dashboard.js:17
#, js-format
msgid "The bot could not be added (error code: %1$s). Try again later, or give an administrator the error code."
msgstr "Botten kunne ikke tilføjes (fejlkode: %1$s). Prøv igen senere, eller giv en administrator fejlkoden."

#: build/dashboard.js:17
msgid "Thank you. The bot writes in your YouTube chat again."
msgstr "Tak. Botten skriver i din YouTube-chat igen."

#: build/dashboard.js:17
msgid "The chatbot is not set up yet. When an administrator has connected it, you can add it to your channel here."
msgstr "Chatbotten er ikke sat op endnu. Når en administrator har forbundet den, kan du tilføje den til din kanal her."

#: build/dashboard.js:17
msgid "Remove the bot from your channel? It no longer writes in your chat."
msgstr "Fjern botten fra din kanal? Den skriver så ikke længere i din chat."

#: build/dashboard.js:17
msgid "The bot was removed from your channel."
msgstr "Botten er fjernet fra din kanal."

#: build/dashboard.js:17
msgid "Google did not let your account see your YouTube livestreams. Remove the bot and add it again with the Google account that owns the channel (for a brand account: its owner), and check that your channel may stream live."
msgstr "Google lod ikke din konto se dine YouTube-livestreams. Fjern botten, og tilføj den igen med den Google-konto, der ejer kanalen (for en brand-konto: dens ejer), og tjek, at din kanal må livestreame."

#: build/dashboard.js:17
msgid "YouTube's daily quota for the chatbot is used up. Messages wait until it resets (midnight Pacific Time)."
msgstr "YouTubes daglige kvote for chatbotten er brugt op. Beskeder venter, til den nulstilles (midnat Pacific Time)."

#: build/dashboard.js:17
msgid "YouTube did not let the bot write. Check that your livestream is not private and that your chat is not for subscribers or members only, and make the bot a moderator."
msgstr "YouTube tillod ikke botten at skrive. Tjek, at din livestream ikke er privat, og at din chat ikke kun er for abonnenter eller medlemmer, og gør botten til moderator."

#: build/dashboard.js:17
msgid "The test message was sent."
msgstr "Testbeskeden er sendt."

#: build/dashboard.js:17
msgid "The test message was not sent: accept the privacy policy and terms of the YouTube chatbot first."
msgstr "Testbeskeden blev ikke sendt: godkend først privatlivspolitikken og vilkårene for YouTube-chatbotten."

#: build/dashboard.js:17
msgid "You are not live on YouTube right now. Test messages can only be written during a livestream."
msgstr "Du er ikke live på YouTube lige nu. Testbeskeder kan kun skrives under en livestream."

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:18
#, js-format
msgid "%1$s asked the bot to wait. Try again in a moment."
msgstr "%1$s bad botten vente. Prøv igen om et øjeblik."

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:19
#, js-format
msgid "%1$s refused the message. Add the bot to your channel again."
msgstr "%1$s afviste beskeden. Tilføj botten til din kanal igen."

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:20
#, js-format
msgid "%1$s did not show the message (e.g. because of your chat settings)."
msgstr "%1$s viste ikke beskeden (fx på grund af dine chatindstillinger)."

#: build/dashboard.js:20
msgid "Chat message"
msgstr "Chatbesked"

#. translators: 1: platform (Twitch or Kick).
#: build/dashboard.js:21
#, js-format
msgid "Write in the %1$s chat when someone buys"
