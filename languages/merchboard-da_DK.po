#: src/Modules/Settings/Admin/SettingsPage.php:120
msgid "Deactivating the plugin never deletes data. Deleting the plugin also keeps all data unless permanent deletion is enabled here."
msgstr "Deaktivering af pluginet sletter aldrig data. Sletning af pluginet bevarer også alle data, medmindre permanent sletning er slået til her."

#: src/Modules/Settings/Admin/SettingsPage.php:123
msgid "Permanent deletion is ENABLED."
msgstr "Permanent sletning er SLÅET TIL."

#: src/Modules/Settings/Admin/SettingsPage.php:124
msgid "When the plugin is deleted from the Plugins screen, all Merch Dashboard data is permanently removed."
msgstr "Når pluginet slettes fra siden Plugins, fjernes alle Merch Dashboard-data permanent."

#: src/Modules/Settings/Admin/SettingsPage.php:126
msgid "Permanent deletion is off. Deleting the plugin keeps all Merch Dashboard data."
msgstr "Permanent sletning er slået fra. Sletning af pluginet bevarer alle Merch Dashboard-data."

#: src/Modules/Settings/Admin/SettingsPage.php:129
msgid "If enabled, deleting the plugin permanently removes: all creators, the audit log, the Merch Dashboard settings and schema state, the \"Merch Dashboard Creator\" role and all merchboard_ capabilities. This cannot be undone."
msgstr "Hvis det er slået til, fjerner sletning af pluginet permanent: alle creators, auditloggen, Merch Dashboards indstillinger og skemastatus, rollen \"Merch Dashboard Creator\" og alle merchboard_-rettigheder. Det kan ikke fortrydes."

#: src/Modules/Settings/Admin/SettingsPage.php:130
msgid "Never removed: WordPress users, other roles and capabilities, posts, pages, media and WooCommerce products, orders and customers."
msgstr "Fjernes aldrig: WordPress-brugere, andre roller og rettigheder, indlæg, sider, medier samt WooCommerce-produkter, -ordrer og -kunder."

#: src/Modules/Settings/Admin/SettingsPage.php:136
msgid "Permanent deletion"
msgstr "Permanent sletning"

#: src/Modules/Settings/Admin/SettingsPage.php:138
msgid "Delete all Merch Dashboard data when the plugin is deleted"
msgstr "Slet alle Merch Dashboard-data, når pluginet slettes"

#: src/Modules/Settings/Admin/SettingsPage.php:142
msgid "Confirmation"
msgstr "Bekræftelse"

#. translators: %s: the word to type, "DELETE".
#: src/Modules/Settings/Admin/SettingsPage.php:145
#, php-format
msgid "To enable permanent deletion, also type %s here."
msgstr "For at slå permanent sletning til skal du også skrive %s her."

#: src/Modules/Settings/Admin/SettingsPage.php:150
msgid "Save settings"
msgstr "Gem indstillinger"

#: src/Modules/Settings/Admin/SettingsPage.php:162
#: templates/dashboard/shell.php:31
msgid "Creator dashboard"
msgstr "Creator-dashboard"

#: src/Modules/Settings/Admin/SettingsPage.php:163
msgid "Creators log in and use their dashboard at this address:"
msgstr "Creators logger ind og bruger deres dashboard på denne adresse:"

#: src/Modules/Settings/Admin/SettingsPage.php:166
msgid "Plain permalinks are active, so the slug is not used; the dashboard address above works regardless."
msgstr "Simple permalinks er aktive, så sluggen bruges ikke; dashboardadressen ovenfor virker alligevel."

#: src/Modules/Settings/Admin/SettingsPage.php:173
msgid "Dashboard URL slug"
msgstr "URL-slug for dashboardet"

#: src/Modules/Settings/Admin/SettingsPage.php:175
msgid "Lowercase letters, digits and hyphens. Changing it moves the dashboard: the old address stops working and bookmarks must be updated. Pages, posts, products and archives that already use a slug cannot be chosen."
msgstr "Små bogstaver, cifre og bindestreger. En ændring flytter dashboardet: den gamle adresse holder op med at virke, og bogmærker skal opdateres. Slugs, som sider, indlæg, produkter og arkiver allerede bruger, kan ikke vælges."

#: src/Modules/Settings/Admin/SettingsPage.php:177
msgid "Save dashboard URL"
msgstr "Gem dashboardadresse"

