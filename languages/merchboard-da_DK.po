#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:90
msgid "Linked to this creator."
msgstr "Tilknyttet denne creator."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:91
msgid "Taken over from the previous creator and linked to this creator."
msgstr "Overtaget fra den tidligere creator og tilknyttet denne creator."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:92
msgid "Link removed."
msgstr "Tilknytning fjernet."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:93
msgid "The link is now manual: same creator, no longer changed by product categories."
msgstr "Tilknytningen er nu manuel: samme creator, og den ændres ikke længere af produktkategorier."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:94
msgid "Nothing changed: confirm that you want to keep the link as manual."
msgstr "Intet blev ændret: bekræft, at du vil beholde tilknytningen som manuel."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:95
msgid "Not removed: the link is managed by a product category. Remove the product from the category, or keep the link as manual first."
msgstr "Ikke fjernet: tilknytningen styres af en produktkategori. Fjern produktet fra kategorien, eller behold tilknytningen som manuel først."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:96
msgid "Not changed: the product no longer has a link to this creator that can be kept as manual."
msgstr "Ikke ændret: produktet har ikke længere en tilknytning til denne creator, der kan beholdes som manuel."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:98
msgid "Select at least one product."
msgstr "Vælg mindst ét produkt."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:99
msgid "The product is linked to another creator, so it was not removed here."
msgstr "Produktet er tilknyttet en anden creator, så det blev ikke fjernet her."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:100
msgid "Not changed: the product is linked to another creator or holds an invalid link. Tick \"Take over\" for this product to move it."
msgstr "Ikke ændret: Produktet er tilknyttet en anden creator eller har en ugyldig tilknytning. Sæt flueben i \"Overtag\" for dette produkt for at flytte det."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:101
msgid "You are not allowed to edit this product."
msgstr "Du har ikke tilladelse til at redigere dette produkt."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:103
msgid "Variations cannot be linked on their own; they belong to the creator of their parent product."
msgstr "Varianter kan ikke tilknyttes alene; de tilhører creatoren af deres overordnede produkt."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:104
msgid "Products in the trash or not yet saved cannot be linked."
msgstr "Produkter i papirkurven eller som endnu ikke er gemt, kan ikke tilknyttes."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:106
msgid "Inactive creators cannot get new products. Activate the creator first."
msgstr "Inaktive creators kan ikke få nye produkter. Aktivér creatoren først."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:107
msgid "A technical error occurred. The product may not have been changed; check it and try again later."
msgstr "Der opstod en teknisk fejl. Produktet er muligvis ikke ændret; kontrollér det, og prøv igen senere."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:125
msgid "You need permission to edit WooCommerce products to see and change the products of this creator."
msgstr "Du skal have tilladelse til at redigere WooCommerce-produkter for at se og ændre denne creators produkter."

#: src/Modules/WooCommerce/Admin/CreatorProductsSection.php:129
msgid "WooCommerce products that belong to this creator. Links are managed only here; the WooCommerce product screen does not show or change them. Variations belong to the creator of their parent product."
msgstr "WooCommerce-produkter, der tilhører denne creator. Tilknytninger administreres kun her; WooCommerce-produktskærmen hverken viser eller ændrer dem. Varianter tilhører creatoren af deres overordnede produkt."

