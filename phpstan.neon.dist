# PHPStan configuration. WordPress stubs are loaded automatically via
# szepeviktor/phpstan-wordpress + phpstan/extension-installer.
parameters:
    level: 8
    phpVersion: 80200
    paths:
        - merchboard.php
        - uninstall.php
        - src
        - templates
        - tests
        # Read-only review script of step 24.5 (not shipped); its test calls its functions.
        - bin/mb-245-cutover-report.php
    excludePaths:
        # Unit-test stand-in for WordPress' wpdb; PHPStan uses the real stubs.
        - tests/Fixtures/wpdb.php
        - tests/Fixtures/wp-role.php
        - tests/Fixtures/wp-user.php
        # Stand-in for an active WooCommerce (global WooCommerce class and
        # WC_VERSION, loaded only in isolated test processes). Analysing it
        # makes the full run exhaust its memory limit.
        - tests/Fixtures/woocommerce-active.php
        # Stand-in for WooCommerce product CRUD (loaded only in isolated test
        # processes); PHPStan uses tests/Stubs/woocommerce.stub instead.
        - tests/Fixtures/woocommerce-product.php
        # Stand-in for WooCommerce order CRUD (isolated test processes only);
        # PHPStan uses tests/Stubs/woocommerce.stub instead.
        - tests/Fixtures/woocommerce-order.php
        # Stand-in for WooCommerce coupon, cart and discounts (isolated test
        # processes only); PHPStan uses tests/Stubs/woocommerce.stub instead.
        - tests/Fixtures/woocommerce-coupon.php
        # Stand-in for Action Scheduler's action class (isolated test processes only);
        # PHPStan uses tests/Stubs/woocommerce.stub instead.
        - tests/Fixtures/action-scheduler-action.php
        # Stand-in for WP_Error and WP_REST_Request (loaded only in isolated
        # test processes); PHPStan uses the real WordPress stubs.
        - tests/Fixtures/wp-rest.php
        - tests/Fixtures/wp-term.php
        - tests/Fixtures/wp-post.php
        # Stand-in for an active YITH WooCommerce Gift Cards (global constants,
        # class and function; isolated test processes only).
        - tests/Fixtures/yith-gift-cards.php
        # Stand-in for an active CCMerch Kategoribannere; PHPStan uses tests/Stubs/ccmerch-kategoribannere.stub.
        - tests/Fixtures/ccmerch-kategoribannere.php
    # Declares the WooCommerce and WP-CLI API the plugin uses (no stubs package, ADR-030 D5).
    scanFiles:
        - tests/Stubs/woocommerce.stub
        - tests/Stubs/wp-cli.stub
        # The banner plugin CCMerch Kategoribannere (phase 28, ADR-077).
        - tests/Stubs/ccmerch-kategoribannere.stub
    # Runtime constants of the integration test harness (tests/Integration/config.php).
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    tmpDir: .tools/phpstan-cache
