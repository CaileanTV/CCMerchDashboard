# PHPStan configuration. WordPress stubs are loaded automatically via
# szepeviktor/phpstan-wordpress + phpstan/extension-installer.
parameters:
    level: 8
    phpVersion: 80200
    paths:
        - merchboard.php
        - uninstall.php
        - src
        - tests
    excludePaths:
        # Unit-test stand-in for WordPress' wpdb; PHPStan uses the real stubs.
        - tests/Fixtures/wpdb.php
    tmpDir: .tools/phpstan-cache
