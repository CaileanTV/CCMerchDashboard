<?php
/**
 * PHPStan stubs: only the WooCommerce API the plugin uses, with signatures
 * taken from WooCommerce 10.3.8 (the minimum, ADR-030). Never loaded at
 * runtime; WooCommerce itself provides these. Extend when new calls are
 * added. A local stub file instead of a stubs package keeps the project free
 * of new dependencies (ADR-030 D5).
 *
 * @package MerchBoard
 */

/**
 * WooCommerce data object (abstract-wc-data.php).
 */
abstract class WC_Data {

	/**
	 * @return int
	 */
	public function get_id() {}

	/**
	 * @return list<WC_Meta_Data>
	 */
	public function get_meta_data() {}

	/**
	 * @param string $key    Meta key.
	 * @param mixed  $value  Meta value.
	 * @param bool   $unique Replace existing entries with the same key.
	 * @return void
	 */
	public function add_meta_data( $key, $value, $unique = false ) {}

	/**
	 * @param int $mid Meta id.
	 * @return void
	 */
	public function delete_meta_data_by_mid( $mid ) {}

	/**
	 * @return void
	 */
	public function save_meta_data() {}

	/**
	 * @param string $key     Meta key.
	 * @param bool   $single  Return the first value only.
	 * @param string $context 'view' or 'edit'.
	 * @return mixed
	 */
	public function get_meta( $key = '', $single = true, $context = 'view' ) {}

	/**
	 * @param string           $key     Meta key.
	 * @param array|string|int $value   Meta value.
	 * @param int              $meta_id Meta id.
	 * @return void
	 */
	public function update_meta_data( $key, $value, $meta_id = 0 ) {}

	/**
	 * @param string $key Meta key.
	 * @return void
	 */
	public function delete_meta_data( $key ) {}
}

/**
 * WooCommerce date (class-wc-datetime.php).
 */
class WC_DateTime extends DateTime {
}

/**
 * Abstract order (abstract-wc-order.php).
 */
abstract class WC_Abstract_Order extends WC_Data {

	/**
	 * @return string
	 */
	public function get_type() {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_status( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_currency( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return WC_DateTime|null
	 */
	public function get_date_created( $context = 'view' ) {}

	/**
	 * @param string|string[] $types Item types.
	 * @return WC_Order_Item[]
	 */
	public function get_items( $types = 'line_item' ) {}
}

/**
 * Order (class-wc-order.php).
 */
class WC_Order extends WC_Abstract_Order {

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return WC_DateTime|null
	 */
	public function get_date_paid( $context = 'view' ) {}
}

/**
 * Refund (class-wc-order-refund.php).
 */
class WC_Order_Refund extends WC_Abstract_Order {
}

/**
 * Order item (class-wc-order-item.php).
 */
class WC_Order_Item extends WC_Data {

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_name( $context = 'view' ) {}
}

/**
 * Product line (class-wc-order-item-product.php).
 */
class WC_Order_Item_Product extends WC_Order_Item {

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return int
	 */
	public function get_product_id( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return int
	 */
	public function get_variation_id( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return int|float
	 */
	public function get_quantity( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string|int
	 */
	public function get_total( $context = 'view' ) {}
}

/**
 * @param mixed $the_order Order id or object.
 * @return WC_Order|WC_Order_Refund|false
 */
function wc_get_order( $the_order = false ) {}

/**
 * @param array<string, mixed> $args Query arguments.
 * @return array<int, WC_Order|WC_Order_Refund|int>|object
 */
function wc_get_orders( $args ) {}

/**
 * Registered order statuses (wc-order-functions.php), keys with `wc-`.
 *
 * @return array<string, string>
 */
function wc_get_order_statuses() {}

/**
 * WooCommerce product (abstract-wc-product.php).
 */
class WC_Product extends WC_Data {

	/**
	 * @param int|WC_Product|object $product Product id or object.
	 */
	public function __construct( $product = 0 ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return array<int|string>
	 */
	public function get_category_ids( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return int
	 */
	public function get_parent_id( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_status( $context = 'view' ) {}

	/**
	 * @param string|list<string> $type Product type(s).
	 * @return bool
	 */
	public function is_type( $type ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_name( $context = 'view' ) {}

	/**
	 * @param string $context 'view' or 'edit'.
	 * @return string
	 */
	public function get_sku( $context = 'view' ) {}
}

/**
 * WooCommerce data store loader (class-wc-data-store.php). For 'product' it
 * wraps WC_Product_Data_Store_CPT.
 */
class WC_Data_Store {

	/**
	 * @param string $object_type Object type, e.g. 'product'.
	 * @return WC_Data_Store
	 */
	public static function load( $object_type ) {}

	/**
	 * Proxied to WC_Product_Data_Store_CPT::search_products().
	 *
	 * @param string          $term               Search term.
	 * @param string          $type               Product type.
	 * @param bool            $include_variations Include variations.
	 * @param bool            $all_statuses       All statuses instead of published.
	 * @param int|null        $limit              Maximum results.
	 * @param array<int>|null $include            Keep only these ids.
	 * @param array<int>|null $exclude            Drop these ids.
	 * @return array<int|string>
	 */
	public function search_products( $term, $type = '', $include_variations = false, $all_statuses = false, $limit = null, $include = null, $exclude = null ) {}
}

/**
 * @param array<string, mixed> $args Query arguments.
 * @return array<mixed>|object
 */
function wc_get_products( $args ) {}

/**
 * One meta entry of a data object (class-wc-meta-data.php). WooCommerce
 * exposes its data through magic properties.
 *
 * @property mixed $id
 * @property mixed $key
 * @property mixed $value
 */
class WC_Meta_Data {

	/**
	 * @return array{id?: mixed, key?: mixed, value?: mixed}
	 */
	public function get_data() {}

	/**
	 * @param string $key Property.
	 * @return mixed
	 */
	public function __get( $key ) {}

	/**
	 * @param string $key   Property.
	 * @param mixed  $value Value.
	 * @return void
	 */
	public function __set( $key, $value ) {}
}

/**
 * WooCommerce cache helper (class-wc-cache-helper.php, CacheNameSpaceTrait).
 */
class WC_Cache_Helper {

	/**
	 * @param string $group Cache group, e.g. "object_<id>".
	 * @return void
	 */
	public static function invalidate_cache_group( $group ) {}
}

/**
 * @param mixed        $the_product Post object or post ID of the product.
 * @param array<mixed> $deprecated  Unused.
 * @return WC_Product|null|false
 */
function wc_get_product( $the_product = false, $deprecated = array() ) {}

/**
 * @param int $post_id Product id.
 * @return void
 */
function wc_delete_product_transients( $post_id = 0 ) {}

/**
 * Action Scheduler 3.9 (bundled with WooCommerce 10.3.8), functions.php.
 *
 * @param string       $hook     Hook.
 * @param array<mixed> $args     Arguments.
 * @param string       $group    Group.
 * @param bool         $unique   Unique by hook and group.
 * @param int          $priority Priority.
 * @return int Action id (0 on failure).
 */
function as_enqueue_async_action( $hook, $args = array(), $group = '', $unique = false, $priority = 10 ) {}

/**
 * @param int          $timestamp When to run.
 * @param string       $hook      Hook.
 * @param array<mixed> $args      Arguments.
 * @param string       $group     Group.
 * @param bool         $unique    Unique by hook and group.
 * @param int          $priority  Priority.
 * @return int Action id (0 on failure).
 */
function as_schedule_single_action( $timestamp, $hook, $args = array(), $group = '', $unique = false, $priority = 10 ) {}

/**
 * @param string            $hook  Hook.
 * @param array<mixed>|null $args  Arguments (null: any).
 * @param string            $group Group.
 * @return bool Whether a pending or running action matches.
 */
function as_has_scheduled_action( $hook, $args = null, $group = '' ) {}

/**
 * @param string       $hook  Hook.
 * @param array<mixed> $args  Arguments.
 * @param string       $group Group.
 * @return void
 */
function as_unschedule_all_actions( $hook, $args = array(), $group = '' ) {}

/**
 * @param array<string, mixed> $args          Query.
 * @param string               $return_format OBJECT, ARRAY_A or 'ids'.
 * @return array<int, ActionScheduler_Action|int|array<mixed>>
 */
function as_get_scheduled_actions( $args = array(), $return_format = 'OBJECT' ) {}

/**
 * Action Scheduler action (ActionScheduler_Action.php).
 */
class ActionScheduler_Action {

	/**
	 * @param string       $hook     Hook.
	 * @param array<mixed> $args     Arguments.
	 * @param mixed        $schedule Schedule.
	 * @param string       $group    Group.
	 */
	public function __construct( $hook, array $args = array(), $schedule = null, $group = '' ) {}

	/**
	 * @return array<mixed>
	 */
	public function get_args() {}
}
